# Copy this file to .env and fill in your own values.
# cp .env.example .env

# ProtonVPN WireGuard private key (required).
# Get it from: ProtonVPN account > Downloads > WireGuard configuration.
# Generate a config, open it, and copy the value after "PrivateKey = ".
WIREGUARD_PRIVATE_KEY=

# ProtonVPN server country to connect through. Leave as-is or change.
VPN_SERVER_COUNTRIES=Netherlands

# Timezone for all containers.
TZ=America/New_York

# LAN subnet allowed to reach the qBittorrent WebUI through Gluetun's firewall.
LAN_SUBNET=192.168.1.0/24

# User/group IDs the *arr containers run as (match your host user to avoid permission issues).
PUID=1000
PGID=1000

# Root path for media/torrent data on the host.
MEDIA_ROOT=./data

# Public URL Jellyfin advertises to clients.
JELLYFIN_URL=http://192.168.1.10:8096

# Upstream DNS server for the Radarr/Sonarr/Prowlarr/FlareSolverr/Jellyfin
# containers. Defaults to 1.1.1.1; set to your router or AdGuard if you prefer.
# CONTAINER_DNS=1.1.1.1
